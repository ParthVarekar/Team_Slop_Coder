{
  "name": "@weft/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Weft local daemon — collection, redaction, indexing, worktrees, validation, local UI.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "weft": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/cli.js start",
    "dev": "tsx src/cli.ts start"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@weft/adapter-claude-code": "workspace:*",
    "@weft/adapter-codex": "workspace:*",
    "@weft/adapter-opencode": "workspace:*",
    "@weft/core": "workspace:*",
    "@weft/protocol": "workspace:*",
    "dependency-cruiser": "^18.7.2",
    "fastify": "^5.12.8",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@parcel/watcher": "^2.5.1"
  }
}
